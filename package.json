{
  "name": "shiftmaker",
  "private": true,
  "version": "2.0.0",
  "description": "ShiftMaker - Medical Shift Management",
  "author": "Antigravity",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5183 && electron .\"",
    "electron:build": "find . -name .git -prune -o -exec xattr -c {} + && vite build && find . -name .git -prune -o -exec xattr -c {} + && electron-builder",
    "ios:init": "npx cap add ios",
    "ios:sync": "npm run build && npx cap sync",
    "ios:open": "npx cap open ios"
  },
  "build": {
    "appId": "com.shiftmaker.app",
    "productName": "ShiftMaker",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/main.js"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "docx": "^9.5.1",
    "file-saver": "^2.0.5",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^14.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3"
  }
}